# Offline and local online tests require no credentials.
# Never place secrets in VITE_* variables: these are included in the client build.
# Defaults: backend 127.0.0.1:2567, client LAN :5173, proxy /online.
# ELDORIA_SERVER_PORT=2567
# ELDORIA_SERVER_HOST=127.0.0.1
# ELDORIA_PROXY_TARGET=http://127.0.0.1:2567
# Optional direct endpoint for a separately hosted client (requires its own server):
# VITE_ONLINE_URL=wss://your-server.example
# Server environment variables are read from the process; main.ts does not load .env.
