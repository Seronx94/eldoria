{
  "name": "eldoria",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --config apps/client/vite.config.ts",
    "dev:lan": "node scripts/dev-lan.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "build": "npm run validate:content && vite build --config apps/client/vite.config.ts",
    "assets:import-town": "node scripts/import-town-art.mjs",
    "maps:generate-town": "node scripts/generate-town.mjs",
    "assets:generate": "python3 scripts/generate-assets.py",
    "assets:import-colorful": "node scripts/import-colorful-art.mjs",
    "assets:import-professions": "node scripts/import-professions-art.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && node scripts/build-apk.mjs",
    "dev:server": "node --env-file-if-exists=.eldoria-local/server.env --import tsx apps/server/src/main.ts",
    "dev:online": "node scripts/dev-online.mjs",
    "db:up": "node scripts/db.mjs",
    "db:down": "node scripts/db.mjs down",
    "account:tier": "node --env-file-if-exists=.eldoria-local/server.env --import tsx scripts/account-tier.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "eslint": "10.12.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3"
  }
}
