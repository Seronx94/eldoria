{
  "name": "eldoria",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --config apps/client/vite.config.ts",
    "dev:lan": "node scripts/dev-lan.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "build": "npm run validate:content && vite build --config apps/client/vite.config.ts",
    "assets:import-town": "node scripts/import-town-art.mjs",
    "maps:generate-town": "node scripts/generate-town.mjs",
    "assets:generate": "python3 scripts/generate-assets.py",
    "assets:import-colorful": "node scripts/import-colorful-art.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
