{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"], "noEmit": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"]
}
